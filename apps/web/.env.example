# Supabase project settings -> API. The anon key is safe to expose to the
# browser (RLS on public.projects enforces per-owner access — see
# supabase/migrations/0001_init.sql); never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by /api/generate to call Claude. Never exposed to
# the browser (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Base URL of the deployed services/vsdx instance — used by
# /api/projects/[id]/export to render the "Download .vsdx" button.
# Defaults to local dev; set to the Railway (or equivalent) URL in production.
VSDX_SERVICE_URL=http://127.0.0.1:8000

# Owner-only /admin beta dashboard (waitlist + tester list). Both are
# server-side only — never give either a NEXT_PUBLIC_ prefix.
#   ADMIN_EMAIL              the single email allowed to open /admin; anyone
#                            else (or unset) gets a 404. No roles/RBAC, per
#                            CLAUDE.md's scope guard.
#   SUPABASE_SERVICE_ROLE_KEY  Supabase -> Settings -> API -> service_role.
#                            FULL-ACCESS SECRET: bypasses RLS. Needed because
#                            public.waitlist has no SELECT policy and listing
#                            auth users requires the admin API. Leave unset in
#                            local dev — /admin degrades with a notice.
ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — PostHog analytics. Safe to leave unset in local dev (analytics
# are just disabled, per instrumentation-client.ts/lib/posthog-server.ts);
# the project token is a client-safe write-only key, not a secret.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
