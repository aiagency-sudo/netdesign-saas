# Supabase project settings -> API. The anon key is safe to expose to the
# browser (RLS on public.projects enforces per-owner access — see
# supabase/migrations/0001_init.sql); never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by /api/generate to call Claude. Never exposed to
# the browser (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Base URL of the deployed services/vsdx instance — used by
# /api/projects/[id]/export to render the "Download .vsdx" button.
# Defaults to local dev; set to the Railway (or equivalent) URL in production.
VSDX_SERVICE_URL=http://127.0.0.1:8000
