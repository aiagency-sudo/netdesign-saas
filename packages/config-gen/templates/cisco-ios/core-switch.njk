{{ banner }}
!
hostname {{ hostname }}
!
ip routing
!
{% for port in routedPorts %}
interface {{ port.name }}
 description {{ port.description }}
 no switchport
 ip address {{ port.ip }} {{ port.netmask }}
 no shutdown
!
{% endfor -%}
{% if ospf %}
router ospf {{ ospf.processId }}
{% for net in ospf.networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ net.area }}
{% endfor -%}
!
{% endif -%}
end
